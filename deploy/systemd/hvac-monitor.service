# Runs the monitor loop that sprays while the HVAC system is heating or cooling.
# Change User and the paths if your account or install folder differ.
[Unit]
Description=HVAC air freshener monitor
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/pi_hvac_controller
ExecStart=/home/pi/pi_hvac_controller/venv/bin/python main.py
Restart=on-failure
# Waits longer than the API between restarts, since a crash here usually means
# missing credentials, which a quick retry won't fix.
RestartSec=30

[Install]
WantedBy=multi-user.target
